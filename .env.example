# Hosted Nest API (origin only, or include /api — both work)
# Used by Electron main and, when prefixed with VITE_, the renderer build.
API_BACKEND_URL=http://127.0.0.1:3001
VITE_API_BACKEND_URL=http://127.0.0.1:3001

# Optional aliases (same meaning)
# NEST_API_URL=http://127.0.0.1:3001/api
# VITE_API_URL=http://127.0.0.1:3001/api
